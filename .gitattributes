# Auto detect text files and normalize line endings
* text=auto

# C# / textbasierte Projektdateien NICHT in LFS
*.cs           text diff=csharp
*.shader       text
*.cginc        text
*.compute      text
*.hlsl         text
*.json         text
*.xml          text
*.txt          text
*.md           text
*.asmdef       text
*.asmref       text
*.meta         text
*.unity        text
*.prefab       text
*.mat          text
*.anim         text
*.controller   text
*.overrideController text
*.playable     text
*.asset        text
*.guiskin      text
*.physicMaterial text
*.terrainlayer text
*.spriteatlas  text

# Typische große Unity/Binärdateien -> Git LFS
*.psd          filter=lfs diff=lfs merge=lfs -text
