.root {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(8, 8, 12, 0.5);
    padding-top: 20px;
}

.title {
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(255, 210, 130);
    -unity-text-align: middle-center;
}

.gift-label {
    margin-top: 8px;
    font-size: 24px;
    color: rgb(255, 184, 92);
    -unity-text-align: middle-center;
}

.timer-label {
    margin-top: 10px;
    font-size: 54px;
    -unity-font-style: bold;
    color: rgb(255, 160, 70);
    -unity-text-align: middle-center;
}

.status-label {
    margin-top: 6px;
    margin-bottom: 10px;
    font-size: 20px;
    color: rgb(255, 210, 145);
    -unity-text-align: middle-center;
}

.start-game-button {
    display: none;
    width: 240px;
    height: 50px;
    margin-bottom: 10px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgba(34, 16, 8, 1);
    background-color: rgba(255, 116, 36, 0.98);
}

.participants-scroll {
    width: 94%;
    max-width: 1400px;
    height: 68%;
}

.participants-grid {
    width: 100%;
    flex-direction: row-reverse;
    align-items: flex-start;
}

.participants-column {
    flex-direction: column;
    align-items: center;
    margin-left: 8px;
    margin-right: 8px;
}

.participant-row {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 160px;
    margin: 8px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.participant-row.visible {
    opacity: 1;
}

.participant-avatar {
    width: 92px;
    height: 92px;
    border-top-left-radius: 46px;
    border-top-right-radius: 46px;
    border-bottom-left-radius: 46px;
    border-bottom-right-radius: 46px;
    background-color: rgba(120, 90, 60, 0.8);
    background-size: cover;
    background-position: center;
}

.participant-name {
    margin-top: 6px;
    font-size: 15px;
    color: rgb(255, 214, 160);
    -unity-text-align: middle-center;
}
