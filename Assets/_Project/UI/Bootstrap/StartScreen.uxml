<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="StartScreen.uss" />

    <ui:VisualElement class="root">
        <ui:VisualElement class="main-content">
            <ui:Label class="title" text="4 Wins" />
            <ui:Label class="subtitle" text="TikTok Community vs Streamer" />

            <ui:VisualElement class="button-row">
                <ui:Button name="start-button" text="Start Game" class="primary-button" />
                <ui:Button name="settings-button" text="Settings" class="secondary-button" />
            </ui:VisualElement>

            <ui:ProgressBar name="loading-progress" title="Loading" low-value="0" high-value="100" value="0" class="progress" />
            <ui:Label name="status-label" class="status" text="Ready" />
        </ui:VisualElement>

        <ui:VisualElement name="settings-modal" class="modal-overlay">
            <ui:VisualElement class="modal-card">
                <ui:Label class="modal-title" text="Settings" />
                <ui:Label class="modal-subtitle" text="Set TikTok streamer username" />

                <ui:TextField name="settings-username-field" label="Username" value="" class="settings-input" />
                <ui:TextField name="settings-community-display-field" label="Community Name" value="Chat" class="settings-input" />
                <ui:TextField name="settings-streamer-display-field" label="Streamer Display Name" value="Streamer" class="settings-input" />
                <ui:IntegerField name="settings-rounds-field" label="Rounds to Win" value="5" class="settings-input" />
                <ui:TextField name="settings-gift-field" label="Registration Gift" value="Rose" class="settings-input" />
                <ui:IntegerField name="settings-registration-seconds-field" label="Registration Time (sec)" value="20" class="settings-input" />
                <ui:TextField name="settings-challenge-gift-field" label="Beginner Challenge Gift" value="Rose" class="settings-input" />
                <ui:IntegerField name="settings-challenge-coin-target-field" label="Beginner Challenge Coin Target" value="500" class="settings-input" />
                <ui:IntegerField name="settings-challenge-seconds-field" label="Beginner Challenge Time (sec)" value="10" class="settings-input" />
                <ui:IntegerField name="settings-participant-turn-seconds-field" label="Player Turn Time (sec)" value="60" class="settings-input" />
                <ui:TextField name="settings-sabotage-gift-field" label="Sabotage Gift" value="Popular Vote" class="settings-input" />
                <ui:Label name="settings-hint-label" class="settings-hint" text="" />

                <ui:VisualElement class="modal-button-row">
                    <ui:Button name="settings-save-button" text="Save" class="primary-button" />
                    <ui:Button name="settings-cancel-button" text="Cancel" class="secondary-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
