.screen {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(8, 8, 12, 0.15);
}

.content-row {
    width: 100%;
    max-width: 1280px;
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
}

.hud-panel {
    flex-grow: 1;
    max-width: 980px;
    margin-top: 2px;
    align-items: center;
    justify-content: center;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 2px;
}

.round-text {
    font-size: 42px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    color: rgb(255, 210, 130);
    -unity-text-align: middle-center;
    -unity-text-outline-color: rgba(255, 120, 30, 0.95);
    -unity-text-outline-width: 2px;
}

.active-player-display {
    margin-top: 0;
    align-items: center;
    justify-content: center;
    min-height: 98px;
}

.active-player-avatar {
    width: 56px;
    height: 56px;
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
    background-color: rgba(120, 90, 60, 0.8);
    background-size: cover;
    background-position: center;
}

.active-player-name {
    margin-top: 6px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 214, 160);
    -unity-text-align: middle-center;
}

.score-columns {
    margin-top: 6px;
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.score-column {
    min-width: 220px;
    align-items: center;
}

.score-column.center {
    min-width: 170px;
    justify-content: center;
}

.name-text {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 184, 92);
    -unity-text-align: middle-center;
}

.score-value-text {
    margin-top: 2px;
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(255, 228, 170);
    -unity-text-align: middle-center;
    transition-property: scale, color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.score-win-pulse {
    scale: 1.16 1.16;
    color: rgb(255, 140, 64);
}

.timer-inline-text {
    margin-top: 4px;
    margin-bottom: 4px;
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(255, 190, 95);
    -unity-text-align: middle-center;
    -unity-text-outline-color: rgba(255, 130, 40, 0.9);
    -unity-text-outline-width: 1px;
}

.info-row {
    width: 100%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
}

.info-text {
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 2px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 184, 92);
    -unity-text-align: middle-center;
    -unity-text-outline-color: rgba(200, 95, 10, 0.9);
    -unity-text-outline-width: 1px;
}

.winner-text {
    color: rgb(255, 224, 160);
}

.participants-panel {
    position: absolute;
    right: 8px;
    top: 10px;
    width: 280px;
    padding: 10px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: rgba(20, 12, 8, 0.85);
}

.participants-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 204, 128);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.participants-scroll {
    max-height: 540px;
}

.participants-scroll > .unity-scroll-view__vertical-scroller,
.participants-scroll > .unity-scroll-view__horizontal-scroller {
    display: none;
}

.participant-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    padding: 6px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(70, 45, 24, 0.35);
    transition-property: scale, background-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.participant-row.active-turn {
    background-color: rgba(255, 158, 72, 0.42);
}

.participant-avatar {
    width: 40px;
    height: 40px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    background-color: rgba(120, 90, 60, 0.8);
    background-size: cover;
    background-position: center;
}

.participant-name {
    margin-left: 10px;
    font-size: 16px;
    color: rgb(255, 214, 160);
}

.popup-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.popup-card {
    min-width: 320px;
    max-width: 90%;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 20px;
    padding-right: 20px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: rgba(25, 16, 8, 0.95);
    align-items: center;
}

.popup-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(255, 214, 145);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.next-round-button {
    width: 220px;
    height: 46px;
    font-size: 21px;
    -unity-font-style: bold;
    color: rgba(34, 16, 8, 1);
    background-color: rgba(255, 116, 36, 0.98);
    border-top-color: rgba(255, 172, 86, 0.95);
    border-right-color: rgba(255, 172, 86, 0.95);
    border-bottom-color: rgba(130, 40, 14, 0.95);
    border-left-color: rgba(255, 172, 86, 0.95);
}
